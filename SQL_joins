create or replace table NEWDATA_SUMM2026.CLMSPTDTLS.clmdtlshdrs as
select cd.OMC_CLM_ID,
    cd.OMC_CLM_DTLS_ID,
    cd.LINE_NUM,
    cd.CLM_TYP,
    cd.INC_FROM,
    cd.INC_TO,
    cd.ICD_CD,
    cd.OMC_ICD_RISK_NBR,
    cd.SUB_CD,
    cd.SUB_TYPE,
    cd.CPT_CD,
    cd.CLMS_CHRG,
    cd.PAID_AMT,
    ch.MBR_ID,
    ch.PT_CD,
    ch.LST_NAME,
    ch.FST_NAME,
    ch.MDL_NAME,
    ch.CLM_NUM
    from NEWDATA_SUMM2026.CLMSPTDTLS.CLMDTLS_TABLE as cd
    inner join NEWDATA_SUMM2026.CLMSPTDTLS.CLMHDRS_TABLE as ch
    on cd.OMC_CLM_ID = ch.OMC_CLM_ID;

SELECT COUNT(*) AS TOTAL_ROWS 
FROM NEWDATA_SUMM2026.CLMSPTDTLS.clmdtlshdrs;


